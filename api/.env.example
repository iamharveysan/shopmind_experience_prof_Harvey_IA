# SOLO EN EL SERVIDOR (Render > Environment). Nunca colocar la clave en index.html ni en GitHub.
# Este archivo es una plantilla: NO escribas aquí tu clave real.
OPENAI_API_KEY=sk-pega-aqui-tu-clave-solo-en-render
OPENAI_MODEL=gpt-4.1-mini
PORT=8787
# Dominio exacto donde publicas index.html (sin barra final), separado por comas.
ALLOWED_ORIGINS=https://TU_USUARIO.github.io,http://localhost:8000,http://127.0.0.1:8000
# Límites de uso (un curso de 40 estudiantes ≈ 15–25 preguntas por estudiante).
MAX_DAILY_REQUESTS=1500
MAX_HOURLY_PER_IP=40
# Render/Railway usan balanceador: deja true para limitar por estudiante y no por servidor.
TRUST_PROXY=true
